{% doc %}
  @prompt
    Create custom CSS to reduce line spacing in text boxes, making text more compact with minimal space between lines, WELL, WE'RE MISSING FORMATTING OPTION TO MAKE IT RIGHT LEFT OR CENTER WHICH IS IMPORTANT!
    , CAN I MAKE EVERY LETTER A DIFFERENT COLOR GOING BETWEEN 6-7 DIFFERENT RAINBOW COLORS
    

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .rainbow-text-{{ ai_gen_id }} {
    line-height: {{ block.settings.line_height }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
    word-spacing: {{ block.settings.word_spacing }}px;
    margin-bottom: {{ block.settings.paragraph_spacing }}px;
    max-width: {{ block.settings.max_width }}px;font-size: {{ block.settings.font_size }}px;text-align: {{ block.settings.text_alignment }};
    margin-left: auto;
    margin-right: auto;
  }

  .rainbow-text-{{ ai_gen_id }} p {
    margin-top: 0;
    margin-bottom: {{ block.settings.paragraph_spacing }}px;
  }

  .rainbow-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .rainbow-text-{{ ai_gen_id }} h1,
  .rainbow-text-{{ ai_gen_id }} h2,
  .rainbow-text-{{ ai_gen_id }} h3,
  .rainbow-text-{{ ai_gen_id }} h4,
  .rainbow-text-{{ ai_gen_id }} h5,
  .rainbow-text-{{ ai_gen_id }} h6 {
    line-height: {{ block.settings.heading_line_height }};
    margin-top: {{ block.settings.heading_top_spacing }}px;
    margin-bottom: {{ block.settings.heading_bottom_spacing }}px;
  }

  .rainbow-text-{{ ai_gen_id }} ul,
  .rainbow-text-{{ ai_gen_id }} ol {
    padding-left: 20px;
    margin-bottom: {{ block.settings.paragraph_spacing }}px;
  }

  .rainbow-text-{{ ai_gen_id }} li {
    margin-bottom: {{ block.settings.list_item_spacing }}px;
  }

  .rainbow-text-{{ ai_gen_id }} li:last-child {
    margin-bottom: 0;
  }

  .rainbow-text-{{ ai_gen_id }} .rainbow-letter-1 {
    color: {{ block.settings.color_1 }};
  }
  .rainbow-text-{{ ai_gen_id }} .rainbow-letter-2 {
    color: {{ block.settings.color_2 }};
  }
  .rainbow-text-{{ ai_gen_id }} .rainbow-letter-3 {
    color: {{ block.settings.color_3 }};
  }
  .rainbow-text-{{ ai_gen_id }} .rainbow-letter-4 {
    color: {{ block.settings.color_4 }};
  }
  .rainbow-text-{{ ai_gen_id }} .rainbow-letter-5 {
    color: {{ block.settings.color_5 }};
  }
  .rainbow-text-{{ ai_gen_id }} .rainbow-letter-6 {
    color: {{ block.settings.color_6 }};
  }
  {% if block.settings.color_7 != blank %}
  .rainbow-text-{{ ai_gen_id }} .rainbow-letter-7 {
    color: {{ block.settings.color_7 }};
  }
  {% endif %}
{% endstyle %}

<div class="rainbow-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <rainbow-text-processor-{{ ai_gen_id }}></rainbow-text-processor-{{ ai_gen_id }}>
</div>

<script>
  (function() {
    class RainbowTextProcessor extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const content = {{ block.settings.text_content | json }};
        const colorCount = {{ block.settings.color_7 | default: '' | size | plus: 6 }};
        
        // Parse the HTML content
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = content;
        
        // Process each text node to apply rainbow colors
        this.processNode(tempDiv, colorCount);
        
        // Set the processed content
        this.innerHTML = tempDiv.innerHTML;
      }
      
      processNode(node, colorCount) {
        if (node.nodeType === Node.TEXT_NODE && node.textContent.trim() !== '') {
          const text = node.textContent;
          let rainbowText = '';
          
          for (let i = 0; i < text.length; i++) {
            const char = text[i];
            if (char.trim() === '') {
              rainbowText += char; // Preserve whitespace
            } else {
              const colorIndex = (i % colorCount) + 1;
              rainbowText += `<span class="rainbow-letter-${colorIndex}">${char}</span>`;
            }
          }
          
          const fragment = document.createRange().createContextualFragment(rainbowText);
          node.parentNode.replaceChild(fragment, node);
        } else if (node.nodeType === Node.ELEMENT_NODE) {
          // Process child nodes
          const childNodes = Array.from(node.childNodes);
          childNodes.forEach(child => this.processNode(child, colorCount));
        }
      }
    }

    customElements.define('rainbow-text-processor-{{ ai_gen_id }}', RainbowTextProcessor);
  })();
</script>

