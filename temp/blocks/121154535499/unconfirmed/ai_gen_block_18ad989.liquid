{% doc %}
  @prompt
    Fix desktop layout positioning for a "Why We Left Etsy" button that is currently overlapping with an image. Create CSS code to properly position the button so it doesn't cover the image, with responsive design that works well on desktop screens while maintaining good visual hierarchy and spacing.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .etsy-button-container-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    margin: {{ block.settings.margin_vertical }}px {{ block.settings.margin_horizontal }}px;
    max-width: 100%;
  }

  .etsy-button-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: {{ block.settings.spacing }}px;
    position: relative;
  }

  .etsy-button-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .etsy-button-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16/9;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .etsy-button-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .etsy-button-wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.button_alignment }};
    margin-top: {{ block.settings.spacing }}px;
  }

  .etsy-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: none;
    transition: background-color 0.3s, transform 0.2s;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    box-shadow: 0 {{ block.settings.button_shadow_blur }}px {{ block.settings.button_shadow_spread }}px rgba(0, 0, 0, {{ block.settings.button_shadow_opacity | divided_by: 100.0 }});
  }

  .etsy-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (min-width: 750px) {
    .etsy-button-container-{{ ai_gen_id }} {
      {% if block.settings.desktop_layout == 'side_by_side' %}
        flex-direction: row;
        align-items: center;
      {% endif %}
    }

    .etsy-button-image-wrapper-{{ ai_gen_id }} {
      {% if block.settings.desktop_layout == 'side_by_side' %}
        width: {{ block.settings.image_width }}%;
        margin-bottom: 0;
        margin-right: {{ block.settings.spacing }}px;
      {% endif %}
    }

    .etsy-button-wrapper-{{ ai_gen_id }} {
      {% if block.settings.desktop_layout == 'side_by_side' %}
        width: calc(100% - {{ block.settings.image_width }}% - {{ block.settings.spacing }}px);
        margin-top: 0;
        {% if block.settings.button_alignment == 'center' %}
          justify-content: center;
        {% elsif block.settings.button_alignment == 'flex-end' %}
          justify-content: flex-end;
        {% else %}
          justify-content: flex-start;
        {% endif %}
      {% endif %}
    }
  }
{% endstyle %}

<div class="etsy-button-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="etsy-button-image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.image %}
      <img 
        src="{{ block.settings.image | image_url: width: 1500 }}"
        alt="{{ block.settings.image.alt | escape }}"
        loading="lazy"
        class="etsy-button-image-{{ ai_gen_id }}"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
      >
    {% else %}
      <div class="etsy-button-image-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="etsy-button-wrapper-{{ ai_gen_id }}">
    <a href="{{ block.settings.button_link }}" class="etsy-button-{{ ai_gen_id }}">
      {{ block.settings.button_text }}
    </a>
  </div>
</div>

