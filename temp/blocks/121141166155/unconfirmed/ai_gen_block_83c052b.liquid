{% doc %}
  @prompt
    Create a dynamic collection template system where ticker LED text, section text, and other template elements automatically change based on the current collection being viewed. The system should allow merchants to set custom ticker text, section headings, and other content for each collection using metafields or collection settings, similar to how collection-specific banners work. Include fallback default content when collection-specific content isn't set.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
.collection-ticker-{{ ai_gen_id }} {
  overflow: hidden;
  background-color: {{ block.settings.background_color }};
  color: {{ block.settings.text_color }};
  padding: {{ block.settings.padding }}px 0;
  position: relative;
  width: 100%;
}

.ticker-content-{{ ai_gen_id }} {
  display: flex;
  white-space: nowrap;
  animation: ticker-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
}

.ticker-item-{{ ai_gen_id }} {
  display: inline-flex;
  align-items: center;
  padding: 0 {{ block.settings.item_spacing }}px;
  font-size: {{ block.settings.font_size }}px;
  font-weight: {{ block.settings.font_weight }};
}

.ticker-separator-{{ ai_gen_id }} {
  display: inline-flex;
  margin: 0 {{ block.settings.item_spacing }}px;
}

@keyframes ticker-scroll-{{ ai_gen_id }} {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

@media screen and (max-width: 749px) {
  .ticker-item-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size_mobile }}px;
  }
}
{% endstyle %}

<div class="collection-ticker-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ticker-content-{{ ai_gen_id }}" id="ticker-{{ ai_gen_id }}">
    {% liquid
      assign collection_ticker_text = collection.metafields.custom.ticker_text | default: block.settings.default_text
      assign ticker_items = collection_ticker_text | split: '|'
      
      if ticker_items.size == 0
        assign ticker_items = block.settings.default_text | split: '|'
      endif
    %}
    
    {% for item in ticker_items %}
      <div class="ticker-item-{{ ai_gen_id }}">{{ item | strip }}</div>
      {% unless forloop.last %}
        <div class="ticker-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</div>
      {% endunless %}
    {% endfor %}
    
    {% for item in ticker_items %}
      <div class="ticker-item-{{ ai_gen_id }}">{{ item | strip }}</div>
      {% unless forloop.last %}
        <div class="ticker-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</div>
      {% endunless %}
    {% endfor %}
  </div>
</div>

<script>
(function() {
  class CollectionTicker extends HTMLElement {
    constructor() {
      super();
    }
    
    connectedCallback() {
      this.tickerContent = document.getElementById('ticker-{{ ai_gen_id }}');
      this.adjustTickerWidth();
      window.addEventListener('resize', this.adjustTickerWidth.bind(this));
    }
    
    adjustTickerWidth() {
      if (!this.tickerContent) return;
      
      const tickerItems = this.tickerContent.querySelectorAll('.ticker-item-{{ ai_gen_id }}');
      const separators = this.tickerContent.querySelectorAll('.ticker-separator-{{ ai_gen_id }}');
      
      if (tickerItems.length === 0) return;
      
      // Reset animation temporarily to measure true width
      this.tickerContent.style.animation = 'none';
      
      // Get the width of the first half of items (original set)
      let totalWidth = 0;
      const halfwayPoint = tickerItems.length / 2;
      
      for (let i = 0; i < halfwayPoint; i++) {
        totalWidth += tickerItems[i].offsetWidth;
        if (i < separators.length && i < halfwayPoint - 1) {
          totalWidth += separators[i].offsetWidth;
        }
      }
      
      // Restore animation
      setTimeout(() => {
        this.tickerContent.style.animation = '';
      }, 10);
    }
    
    disconnectedCallback() {
      window.removeEventListener('resize', this.adjustTickerWidth.bind(this));
    }
  }
  
  customElements.define('collection-ticker-{{ ai_gen_id }}', CollectionTicker);
})();
</script>

{% schema %}
{
  "name": "Collection Ticker",
  "tag": null,
  "class": "collection-ticker-section",
  "settings": [
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "textarea",
      "id": "default_text",
      "label": "Default ticker text",
      "info": "Separate items with | character",
      "default": "Free shipping on orders over $100 | New arrivals weekly | Limited time offers"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator",
      "default": "•"
    },
    {
      "type": "header",
      "content": "Style Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Vertical padding",
      "default": 10
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Font size (mobile)",
      "default": 14
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "item_spacing",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "label": "Item spacing",
      "default": 15
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Scroll speed",
      "default": 30
    },
    {
      "type": "paragraph",
      "content": "To set collection-specific ticker text, add a metafield with namespace 'custom' and key 'ticker_text' to your collections."
    }
  ],
  "presets": [
    {
      "name": "Collection Ticker"
    }
  ]
}
{% endschema %}