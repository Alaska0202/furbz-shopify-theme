{% doc %}
  @prompt
    Create a customizable buy button with improved styling and color options to replace a black buy button that needs fixing

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-buy-button-{{ ai_gen_id }} {
    display: inline-block;
    width: {{ block.settings.button_width }}%;
    max-width: 100%;
  }

  .ai-buy-button__button-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    line-height: 1.5;
    text-align: center;
    text-decoration: none;
    text-transform: {{ block.settings.text_transform }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
    color: {{ block.settings.text_color }};
    background-color: {{ block.settings.background_color }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    box-shadow: {{ block.settings.shadow_horizontal }}px {{ block.settings.shadow_vertical }}px {{ block.settings.shadow_blur }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
    transition: all 0.3s ease;
    cursor: pointer;
    overflow: hidden;
  }

  .ai-buy-button__button-{{ ai_gen_id }}:hover {
    color: {{ block.settings.text_hover_color }};
    background-color: {{ block.settings.background_hover_color }};
    border-color: {{ block.settings.border_hover_color }};
    transform: translateY({{ block.settings.hover_lift }}px);
  }

  .ai-buy-button__button-{{ ai_gen_id }}:focus {
    outline: none;
    box-shadow: 0 0 0 2px {{ block.settings.focus_ring_color }};
  }

  .ai-buy-button__icon-{{ ai_gen_id }} {
    display: {% if block.settings.show_icon %}flex{% else %}none{% endif %};
    margin-right: {% if block.settings.icon_position == 'left' %}8px{% else %}0{% endif %};
    margin-left: {% if block.settings.icon_position == 'right' %}8px{% else %}0{% endif %};
    order: {% if block.settings.icon_position == 'left' %}0{% else %}1{% endif %};
  }

  .ai-buy-button__icon-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    fill: currentColor;
  }

  @media screen and (max-width: 749px) {
    .ai-buy-button__button-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.8 }}px {{ block.settings.padding_horizontal | times: 0.8 }}px;
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }
    
    .ai-buy-button-{{ ai_gen_id }} {
      width: {{ block.settings.button_width_mobile }}%;
    }
  }
{% endstyle %}

<div class="ai-buy-button-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <button 
    type="button"
    class="ai-buy-button__button-{{ ai_gen_id }}"
    {% if block.settings.product != blank %}
      data-product-id="{{ block.settings.product.id }}"
    {% endif %}
    aria-label="{{ block.settings.button_text }}"
  >
    {% if block.settings.show_icon and block.settings.icon_position == 'left' %}
      <span class="ai-buy-button__icon-{{ ai_gen_id }}">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
        </svg>
      </span>
    {% endif %}
    
    <span class="ai-buy-button__text-{{ ai_gen_id }}">{{ block.settings.button_text }}</span>
    
    {% if block.settings.show_icon and block.settings.icon_position == 'right' %}
      <span class="ai-buy-button__icon-{{ ai_gen_id }}">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
        </svg>
      </span>
    {% endif %}
  </button>
</div>

<script>
  (function() {
    class AiBuyButton extends HTMLElement {
      constructor() {
        super();
        this.button = this.querySelector('.ai-buy-button__button-{{ ai_gen_id }}');
        this.productId = this.button.dataset.productId;
      }

      connectedCallback() {
        this.button.addEventListener('click', this.handleAddToCart.bind(this));
      }

      async handleAddToCart() {
        if (!this.productId) return;

        try {
          this.button.classList.add('loading');
          this.button.disabled = true;

          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              items: [{
                id: this.productId,
                quantity: 1
              }]
            })
          });

          if (response.ok) {
            // Refresh cart drawer or redirect based on theme settings
            if (typeof window.refreshCart === 'function') {
              window.refreshCart();
            } else {
              window.location.href = '/cart';
            }
          } else {
            const data = await response.json();
            console.error('Error adding to cart:', data);
          }
        } catch (error) {
          console.error('Error adding to cart:', error);
        } finally {
          this.button.classList.remove('loading');
          this.button.disabled = false;
        }
      }
    }

    customElements.define('ai-buy-button-{{ ai_gen_id }}', AiBuyButton);
  })();
</script>

