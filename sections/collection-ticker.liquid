{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
.collection-ticker-{{ ai_gen_id }} {
  overflow: hidden;
  background-image: url("https://cdn.shopify.com/s/files/1/0616/4761/8123/files/tickerthing.png?v=1749278482");
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
  color: {{ block.settings.text_color }};
  padding: {{ block.settings.padding }}px 0;
  position: relative;
  width: 100%;
  margin-top: {{ block.settings.margin_top }}px;
  margin-bottom: {{ block.settings.margin_bottom }}px;
}

.ticker-content-{{ ai_gen_id }} {
  display: flex;
  white-space: nowrap;
  animation: ticker-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
}

.ticker-item-{{ ai_gen_id }} {
  display: inline-flex;
  align-items: center;
  padding: 0 {{ block.settings.item_spacing }}px;
  font-size: {{ block.settings.font_size }}px;
  font-weight: {{ block.settings.font_weight }};
}

.ticker-separator-{{ ai_gen_id }} {
  display: inline-flex;
  margin: 0 {{ block.settings.item_spacing }}px;
}

@keyframes ticker-scroll-{{ ai_gen_id }} {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

@media screen and (max-width: 749px) {
  .ticker-item-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size_mobile }}px;
  }
}
{% endstyle %}

<div class="collection-ticker-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ticker-content-{{ ai_gen_id }}" id="ticker-{{ ai_gen_id }}">
    {% assign raw_ticker_text = block.settings.default_text %}
    {% assign ticker_items = raw_ticker_text | split: '|' %}

    {% for item in ticker_items %}
      <div class="ticker-item-{{ ai_gen_id }}">{{ item | strip }}</div>
      {% unless forloop.last %}
        <div class="ticker-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</div>
      {% endunless %}
    {% endfor %}

    {% for item in ticker_items %}
      <div class="ticker-item-{{ ai_gen_id }}">{{ item | strip }}</div>
      {% unless forloop.last %}
        <div class="ticker-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</div>
      {% endunless %}
    {% endfor %}
  </div>
</div>