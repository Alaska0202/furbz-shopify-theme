{% if settings.logo != blank %}
  <a href="{{ routes.root_url }}" class="header__logo-link" style="display: inline-block;">
    <img
      src="{{ settings.logo | img_url: 'master' }}"
      alt="{{ shop.name }}"
      class="header__logo-image"
      style="max-height: 60px;" />
  </a>
{% else %}
  <h1 class="header__site-name">
    <a href="{{ routes.root_url }}">{{ shop.name }}</a>
  </h1>
{% endif %}